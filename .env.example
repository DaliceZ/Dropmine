PORT=3001
NODE_ENV=development
# Frontend: public build-time URL. Leave empty for local development or same-origin hosting.
# Leave empty for same-project Vercel deployment. Rebuild after changing it. Never put secrets in VITE_*.
VITE_SIGNALING_URL=
# Production: exact public origin, e.g. https://drop.example.com
PUBLIC_ORIGIN=
# Enable only behind this many trusted reverse proxies; never expose Node directly then.
TRUST_PROXY_HOPS=0
# Optional STUN discovery. No TURN relay is configured in v1.
STUN_URL=
# Set false for a standalone signaling backend (Vercel hosts the frontend).
SERVE_FRONTEND=true
# Backend only: Upstash TCP/TLS connection string, NOT the REST URL/token. Required on Vercel.
REDIS_URL=
# Isolate production and preview environments. All instances of one deployment environment share this value.
REDIS_NAMESPACE=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NETWORK_GROUP_SECRET=
